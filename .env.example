APP_DATABASE_PROVIDER=sqlite
APP_FILE_STORAGE_PROVIDER=local
# Development only. Keep 0 by default. Setting 1 skips only the PostgreSQL
# Recipe network/data checks; static provider, client, schema, port and SSL
# guards remain mandatory.
RECIPE_SKIP_PREFLIGHT=0
DATABASE_URL="file:./dev.db"
SUPABASE_DATABASE_URL=
SUPABASE_DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional server aliases used by the Auth foundation. When omitted, the
# validated NEXT_PUBLIC_* values above are reused server-side.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET="asset-files"
LOCAL_ASSET_UPLOAD_DIR=
DATABASE_SCHEMA="immos"
APP_NAME="Inventaire Immos"
